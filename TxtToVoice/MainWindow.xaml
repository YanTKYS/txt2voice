<Window x:Class="TxtToVoice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="声の広報 テキスト読み上げツール"
        Height="800" Width="1280"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5"
        Closing="Window_Closing"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>

        <!-- ===== ボタンスタイル ===== -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background"   Value="#2C5F8A"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"      Value="12,5"/>
            <Setter Property="Margin"       Value="3,2"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Height"       Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A4D73"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#8AAEC5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0F3A56"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#B03020"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#8B2318"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#C89590"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnSuccess" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#2E7D32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B5E20"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#7AAB7C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnWarn" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#E65100"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BF360C"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#D4A090"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== パネルヘッダー ===== -->
        <Style x:Key="PanelHeader" TargetType="Border">
            <Setter Property="Background" Value="#2C5F8A"/>
            <Setter Property="Padding"    Value="10,6"/>
        </Style>

        <Style x:Key="SubPanelHeader" TargetType="Border">
            <Setter Property="Background" Value="#3E6F96"/>
            <Setter Property="Padding"    Value="10,5"/>
        </Style>

        <Style x:Key="PanelHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ===== スクロール付きテキストボックス ===== -->
        <Style x:Key="ManuscriptBox" TargetType="TextBox">
            <Setter Property="FontSize"               Value="14"/>
            <Setter Property="FontFamily"             Value="Meiryo UI, Yu Gothic UI, MS UI Gothic"/>
            <Setter Property="Padding"                Value="8"/>
            <Setter Property="Background"             Value="White"/>
            <Setter Property="BorderBrush"            Value="#C0C0C0"/>
            <Setter Property="BorderThickness"        Value="1"/>
            <Setter Property="AcceptsReturn"          Value="True"/>
            <Setter Property="TextWrapping"           Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="SpellCheck.IsEnabled"   Value="False"/>
        </Style>

        <Style x:Key="PreviewBox" TargetType="TextBox">
            <Setter Property="FontSize"               Value="13"/>
            <Setter Property="FontFamily"             Value="Meiryo UI, Yu Gothic UI, MS UI Gothic"/>
            <Setter Property="Padding"                Value="8"/>
            <Setter Property="Background"             Value="#FDFDF0"/>
            <Setter Property="BorderBrush"            Value="#C0C0C0"/>
            <Setter Property="BorderThickness"        Value="1"/>
            <Setter Property="AcceptsReturn"          Value="True"/>
            <Setter Property="TextWrapping"           Value="Wrap"/>
            <Setter Property="IsReadOnly"             Value="True"/>
            <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- メニュー -->
            <RowDefinition Height="*"/>     <!-- メインコンテンツ -->
            <RowDefinition Height="Auto"/>  <!-- ステータスバー -->
        </Grid.RowDefinitions>

        <!-- ===== メニューバー ===== -->
        <Menu Grid.Row="0" Background="#1B3A5A"
              FontSize="13" Padding="2,2">
            <Menu.Resources>
                <!-- ドロップダウン項目は濃色文字、トップレベル項目は白文字 -->
                <Style TargetType="MenuItem">
                    <Setter Property="Padding"    Value="8,4"/>
                    <Setter Property="Foreground" Value="#1C1C1C"/>
                    <Style.Triggers>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelItem">
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Menu.Resources>

            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="テキストファイルを開く(_O)..."
                          x:Name="MenuOpenFile" Click="MenuOpenFile_Click"
                          InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="最近使ったファイル(_R)" x:Name="MenuRecentFiles">
                    <MenuItem Header="（なし）" IsEnabled="False"/>
                </MenuItem>
                <Separator x:Name="SepAfterRecentFiles"/>
                <MenuItem Header="設定(_T)..." Click="MenuSettings_Click"/>
                <MenuItem Header="読みルール(_L)..." Click="MenuTextRules_Click"/>
                <Separator/>
                <MenuItem Header="終了(_X)" Click="MenuExit_Click"/>
            </MenuItem>

            <MenuItem Header="辞書(_D)">
                <MenuItem Header="CSV インポート(_I)..."
                          Click="MenuImportCsv_Click"/>
                <MenuItem Header="CSV エクスポート(_E)..."
                          Click="MenuExportCsv_Click"/>
                <Separator/>
                <MenuItem Header="サンプル辞書を読み込む(_S)"
                          Click="MenuLoadSample_Click"/>
            </MenuItem>

            <MenuItem Header="ヘルプ(_H)">
                <MenuItem Header="ショートカットキー一覧(_K)"
                          Click="MenuShortcuts_Click"/>
                <MenuItem Header="バージョン情報(_A)"
                          Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- ===== メインコンテンツ ===== -->
        <Grid Grid.Row="1" Margin="6,4,6,4">
            <Grid.ColumnDefinitions>
                <!-- 左: 原稿入力 -->
                <ColumnDefinition Width="0.95*" MinWidth="280"/>
                <ColumnDefinition Width="5"/>
                <!-- 右: プレビュー・辞書・再生 -->
                <ColumnDefinition Width="1.05*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== 左カラム: 原稿入力 ==================== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ヘッダー -->
                <Border Grid.Row="0" Style="{StaticResource PanelHeader}">
                    <DockPanel>
                        <TextBlock Text="原稿入力" Style="{StaticResource PanelHeaderText}"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    DockPanel.Dock="Right">
                            <Button Content="ファイルを開く" Style="{StaticResource BtnPrimary}"
                                    Click="BtnOpenFile_Click"
                                    ToolTip="テキストファイルを読み込む (Ctrl+O)"
                                    Padding="10,4"/>
                            <Button Content="クリア" Style="{StaticResource BtnDanger}"
                                    Click="BtnClearText_Click"
                                    ToolTip="入力内容をすべて消去する"
                                    Padding="10,4"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- テキスト入力エリア -->
                <TextBox Grid.Row="1" x:Name="TxtInput"
                         Style="{StaticResource ManuscriptBox}"
                         TextChanged="TxtInput_TextChanged"
                         IsInactiveSelectionHighlightEnabled="True"
                         ToolTip="読み上げる原稿をここに入力または貼り付けてください。&#10;テキストを選択して読み上げ開始すると、選択範囲のみ読み上げます。"/>

                <!-- フッター: 文字数 + 想定読み上げ時間 + 自動プレビュー + プレビュー更新ボタン -->
                <Border Grid.Row="2" Background="#E4E8EE" Padding="8,5">
                    <DockPanel>
                        <TextBlock x:Name="TxtCharCount"
                                   Text="0 文字"
                                   FontSize="11" Foreground="#555"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtEstTime"
                                   Text=""
                                   FontSize="11" Foreground="#777"
                                   VerticalAlignment="Center"/>
                        <Button Content="辞書を適用してプレビュー更新 (Ctrl+P)"
                                Style="{StaticResource BtnSuccess}"
                                DockPanel.Dock="Right"
                                Click="BtnApplyDictionary_Click"
                                ToolTip="入力テキストに辞書を適用し、プレビューを更新します"
                                Padding="14,4"/>
                        <CheckBox x:Name="ChkAutoPreview"
                                  Content="自動更新"
                                  DockPanel.Dock="Right"
                                  VerticalAlignment="Center"
                                  FontSize="11"
                                  Margin="0,0,10,0"
                                  ToolTip="オンにすると入力中に自動でプレビューを更新します（500ms デバウンス）"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ===== 垂直スプリッター ===== -->
            <GridSplitter Grid.Column="1" Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#BCC5D0"
                          ShowsPreview="True"/>

            <!-- ==================== 右カラム ==================== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- プレビュー -->
                    <RowDefinition Height="2.2*" MinHeight="120"/>
                    <RowDefinition Height="5"/>
                    <!-- 辞書一覧 -->
                    <RowDefinition Height="2.5*" MinHeight="120"/>
                    <RowDefinition Height="5"/>
                    <!-- 再生操作 -->
                    <RowDefinition Height="1.8*" MinHeight="160"/>
                </Grid.RowDefinitions>

                <!-- == プレビュー == -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SubPanelHeader}">
                        <DockPanel>
                            <TextBlock Text="辞書補正後プレビュー（読み上げ確認）"
                                       Style="{StaticResource PanelHeaderText}"/>
                            <TextBlock Text="※ 黄色背景は確認用。実際の読み上げには使用しません"
                                       FontSize="10" Foreground="#CCE0FF"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="8,0,0,0"/>
                        </DockPanel>
                    </Border>

                    <TextBox Grid.Row="1" x:Name="TxtPreview"
                             Style="{StaticResource PreviewBox}"
                             ToolTip="辞書適用後のテキストプレビュー。【元表記→読み】形式で変換箇所を確認できます。"/>

                    <Border Grid.Row="2" Background="#E4E8EE" Padding="8,4">
                        <DockPanel>
                            <Button Content="コピー"
                                    DockPanel.Dock="Right"
                                    Click="BtnCopyPreview_Click"
                                    FontSize="11" Padding="10,2"
                                    VerticalAlignment="Center"
                                    ToolTip="プレビューテキストをクリップボードにコピーします"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="RbPreviewAnnotated"
                                             Content="【変換箇所を表示】"
                                             IsChecked="True"
                                             GroupName="PreviewMode"
                                             FontSize="11" Margin="0,0,16,0"
                                             Checked="PreviewMode_Changed"
                                             ToolTip="変換箇所を【元表記→読み】形式で表示"/>
                                <RadioButton x:Name="RbPreviewClean"
                                             Content="読み上げ用テキストのみ"
                                             GroupName="PreviewMode"
                                             FontSize="11"
                                             Checked="PreviewMode_Changed"
                                             ToolTip="実際に読み上げるテキストのみ表示"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ===== 水平スプリッター 1 ===== -->
                <GridSplitter Grid.Row="1" Height="5"
                              HorizontalAlignment="Stretch"
                              Background="#BCC5D0"
                              ShowsPreview="True"/>

                <!-- == 辞書一覧 == -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SubPanelHeader}">
                        <DockPanel>
                            <TextBlock Text="辞書一覧"
                                       Style="{StaticResource PanelHeaderText}"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        DockPanel.Dock="Right">
                                <Button Content="追加" Style="{StaticResource BtnSuccess}"
                                        Click="BtnAddEntry_Click"
                                        ToolTip="新しい辞書エントリを追加 (Ins)"
                                        Padding="8,3"/>
                                <Button Content="編集" Style="{StaticResource BtnPrimary}"
                                        Click="BtnEditEntry_Click"
                                        ToolTip="選択したエントリを編集 (F2)"
                                        Padding="8,3"/>
                                <Button Content="削除" Style="{StaticResource BtnDanger}"
                                        Click="BtnDeleteEntry_Click"
                                        ToolTip="選択したエントリを削除 (Del)"
                                        Padding="8,3"/>
                                <Button Content="CSV読込" Style="{StaticResource BtnPrimary}"
                                        Click="MenuImportCsv_Click"
                                        ToolTip="CSV ファイルからインポート"
                                        Padding="8,3"/>
                                <Button Content="CSV出力" Style="{StaticResource BtnPrimary}"
                                        Click="MenuExportCsv_Click"
                                        ToolTip="CSV ファイルとしてエクスポート"
                                        Padding="8,3"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 絞り込み入力欄 -->
                    <Border Grid.Row="1" Background="#F5F7FA"
                            BorderBrush="#C8CDD4" BorderThickness="0,0,0,1"
                            Padding="6,4">
                        <DockPanel>
                            <TextBlock Text="絞り込み:" VerticalAlignment="Center"
                                       FontSize="11" Foreground="#555" Margin="0,0,5,0"/>
                            <Button x:Name="BtnDictFilterClear" DockPanel.Dock="Right"
                                    Content="×" Padding="5,1" Margin="4,0,0,0"
                                    FontSize="11" VerticalAlignment="Center"
                                    Click="BtnDictFilterClear_Click"
                                    ToolTip="フィルターをクリア"/>
                            <TextBox x:Name="TxtDictFilter"
                                     TextChanged="TxtDictFilter_TextChanged"
                                     FontSize="12" Padding="4,2"
                                     VerticalAlignment="Center"
                                     ToolTip="表記・読み・備考で絞り込み（部分一致）"/>
                        </DockPanel>
                    </Border>

                    <DataGrid Grid.Row="2" x:Name="DgDictionary"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F0F5FF"
                              Background="White"
                              RowBackground="White"
                              BorderThickness="1"
                              BorderBrush="#C0C0C0"
                              FontSize="12"
                              FontFamily="Meiryo UI, Yu Gothic UI"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              HeadersVisibility="Column"
                              MouseDoubleClick="DgDictionary_MouseDoubleClick"
                              KeyDown="DgDictionary_KeyDown">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"  Value="#D8E4EF"/>
                                <Setter Property="FontWeight"  Value="Bold"/>
                                <Setter Property="Padding"     Value="6,4"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="#B0BEC5"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="表記"
                                                Binding="{Binding Display}"
                                                Width="140"/>
                            <DataGridTextColumn Header="読み"
                                                Binding="{Binding Reading}"
                                                Width="140"/>
                            <DataGridTextColumn Header="備考"
                                                Binding="{Binding Remarks}"
                                                Width="*"/>
                            <DataGridTextColumn Header="優先"
                                                Binding="{Binding Priority}"
                                                Width="52"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="3" Background="#E4E8EE" Padding="8,4">
                        <TextBlock x:Name="TxtDictCount"
                                   Text="辞書: 0 件"
                                   FontSize="11" Foreground="#555"/>
                    </Border>
                </Grid>

                <!-- ===== 水平スプリッター 2 ===== -->
                <GridSplitter Grid.Row="3" Height="5"
                              HorizontalAlignment="Stretch"
                              Background="#BCC5D0"
                              ShowsPreview="True"/>

                <!-- == 再生操作 == -->
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SubPanelHeader}">
                        <TextBlock Text="再生操作"
                                   Style="{StaticResource PanelHeaderText}"/>
                    </Border>

                    <Grid Grid.Row="1" Margin="10,8,10,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 音声選択 -->
                        <DockPanel Grid.Row="0">
                            <TextBlock Text="音声：" VerticalAlignment="Center"
                                       MinWidth="44" FontSize="12" Margin="0,0,4,0"/>
                            <ComboBox x:Name="CmbVoice"
                                      SelectionChanged="CmbVoice_SelectionChanged"
                                      VerticalContentAlignment="Center"
                                      FontSize="12" Height="28"
                                      ToolTip="読み上げに使用する音声エンジンを選択します"/>
                        </DockPanel>

                        <!-- 速度・音量スライダー -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 速度 -->
                            <DockPanel Grid.Column="0">
                                <TextBlock Text="速度：" VerticalAlignment="Center"
                                           MinWidth="44" FontSize="12"/>
                                <TextBlock x:Name="TxtRateVal"
                                           Text="0" VerticalAlignment="Center"
                                           MinWidth="24" FontSize="12"
                                           HorizontalAlignment="Right" Margin="0,0,6,0"
                                           Foreground="#333"/>
                                <Slider x:Name="SldRate"
                                        Minimum="-10" Maximum="10" Value="0"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        AutoToolTipPlacement="TopLeft"
                                        VerticalAlignment="Center"
                                        ValueChanged="SldRate_ValueChanged"
                                        ToolTip="-10（最遅）〜 0（標準）〜 +10（最速）"/>
                            </DockPanel>

                            <!-- 音量 -->
                            <DockPanel Grid.Column="2">
                                <TextBlock Text="音量：" VerticalAlignment="Center"
                                           MinWidth="44" FontSize="12"/>
                                <TextBlock x:Name="TxtVolumeVal"
                                           Text="100" VerticalAlignment="Center"
                                           MinWidth="32" FontSize="12"
                                           HorizontalAlignment="Right" Margin="0,0,6,0"
                                           Foreground="#333"/>
                                <Slider x:Name="SldVolume"
                                        Minimum="0" Maximum="100" Value="100"
                                        VerticalAlignment="Center"
                                        ValueChanged="SldVolume_ValueChanged"
                                        ToolTip="0（無音）〜 100（最大音量）"/>
                            </DockPanel>
                        </Grid>

                        <!-- SSML ポーズ挿入 -->
                        <StackPanel Grid.Row="4">
                            <CheckBox x:Name="ChkSsml"
                                      Content="句読点・改行に自動ポーズを挿入する（SSML モード）"
                                      FontSize="12" VerticalContentAlignment="Center"
                                      Checked="ChkSsml_Changed" Unchecked="ChkSsml_Changed"
                                      ToolTip="有効にすると句読点（。！？、）や改行の後に自然な間が入ります。&#10;※ SSML モード中は読み上げ位置ハイライトが無効になります。"/>
                            <DockPanel Margin="18,4,0,0"
                                       IsEnabled="{Binding IsChecked, ElementName=ChkSsml}">
                                <TextBlock Text="ポーズ強度："
                                           VerticalAlignment="Center"
                                           FontSize="11" Foreground="#555"
                                           Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbSsmlStrength" Width="120" FontSize="11"
                                          SelectionChanged="CmbSsmlStrength_SelectionChanged"
                                          ToolTip="句読点・改行後のポーズの長さを調整します">
                                    <ComboBoxItem Content="短め"/>
                                    <ComboBoxItem Content="標準（既定）" IsSelected="True"/>
                                    <ComboBoxItem Content="長め"/>
                                </ComboBox>
                            </DockPanel>
                        </StackPanel>

                        <!-- 読み上げ位置ハイライト -->
                        <CheckBox Grid.Row="6" x:Name="ChkHighlight"
                                  IsChecked="True"
                                  Content="読み上げ中の位置を蛍光色でハイライト表示する"
                                  FontSize="12" VerticalContentAlignment="Center"
                                  Checked="ChkHighlight_Changed" Unchecked="ChkHighlight_Changed"
                                  ToolTip="読み上げ中の単語を蛍光イエローでハイライト表示します。&#10;蛍光色はテキスト選択（青）とは異なるため、誤操作との混同を防ぎます。&#10;※ SSML モード中は無効です。"/>

                        <!-- 再生ボタン群 -->
                        <WrapPanel Grid.Row="8" Orientation="Horizontal">
                            <Button x:Name="BtnPlay"
                                    Content="▶ 読み上げ開始"
                                    Style="{StaticResource BtnSuccess}"
                                    Click="BtnPlay_Click"
                                    ToolTip="読み上げを開始します (F5)&#10;テキストを選択中の場合は選択範囲のみ読み上げます"
                                    FontSize="13" Padding="14,6" Height="34"/>
                            <Button x:Name="BtnPause"
                                    Content="⏸ 一時停止"
                                    Style="{StaticResource BtnWarn}"
                                    Click="BtnPause_Click"
                                    IsEnabled="False"
                                    ToolTip="読み上げを一時停止します (F6)"
                                    FontSize="13" Padding="14,6" Height="34"/>
                            <Button x:Name="BtnResume"
                                    Content="▶ 再開"
                                    Style="{StaticResource BtnPrimary}"
                                    Click="BtnResume_Click"
                                    IsEnabled="False"
                                    ToolTip="一時停止中の読み上げを再開します (F7)"
                                    FontSize="13" Padding="14,6" Height="34"/>
                            <Button x:Name="BtnStop"
                                    Content="⏹ 停止"
                                    Style="{StaticResource BtnDanger}"
                                    Click="BtnStop_Click"
                                    IsEnabled="False"
                                    ToolTip="読み上げを停止します (F8)"
                                    FontSize="13" Padding="14,6" Height="34"/>
                            <Button x:Name="BtnSaveWav"
                                    Content="音声保存"
                                    Style="{StaticResource BtnPrimary}"
                                    Click="BtnSaveWav_Click"
                                    ToolTip="辞書補正後のテキストを音声ファイルとして保存します (Ctrl+S)&#10;WAV / MP3 / MP4(AAC) を選択できます"
                                    FontSize="13" Padding="14,6" Height="34"/>
                        </WrapPanel>

                        <!-- ショートカットキー案内 -->
                        <Border Grid.Row="10"
                                Background="#E8EEF4"
                                CornerRadius="3"
                                Padding="8,5">
                            <TextBlock FontSize="11" Foreground="#555"
                                       TextWrapping="Wrap">
                                <Run FontWeight="Bold">ショートカット：</Run>
                                <Run>F5=開始　F6=一時停止　F7=再開　F8=停止</Run>
                                <LineBreak/>
                                <Run>Ctrl+O=ファイルを開く　Ctrl+P=プレビュー更新　Ctrl+S=音声保存</Run>
                                <LineBreak/>
                                <Run>辞書一覧：Ins=追加　F2=編集　Del=削除</Run>
                                <LineBreak/>
                                <Run FontStyle="Italic">テキストを選択してF5を押すと選択範囲のみ読み上げます</Run>
                            </TextBlock>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== ステータスバー ===== -->
        <StatusBar Grid.Row="2" Background="#1B3A5A" Height="24">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus"
                           Text="準備完了"
                           Foreground="White"
                           FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
