<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net8.0-windows10.0.19041.0: WinRT API (Windows.Media.SpeechSynthesis 等) を利用するために必要 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>TxtToVoice</RootNamespace>
    <AssemblyName>TxtToVoice</AssemblyName>
    <Company>声の広報 制作支援</Company>
    <Product>テキスト読み上げツール</Product>
    <Version>0.6.8</Version>
    <ApplicationIcon></ApplicationIcon>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Speech は .NET 8 では NuGet パッケージが必要 -->
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <!-- MP3 / MP4(AAC) エンコード（Windows Media Foundation 経由） -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- OS 非依存の純ロジック層（DictionaryService / CsvService / Logger 等） -->
    <ProjectReference Include="../TxtToVoice.Core/TxtToVoice.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- サンプル辞書を出力ディレクトリにコピー -->
    <Content Include="Data\sample_dictionary.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- テキスト変換ルール（ユーザー編集可・デフォルトは全 disabled） -->
    <Content Include="Data\text_rules.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- THIRD_PARTY_LICENSES.txt（同梱必須: CC BY 3.0 等のライセンス義務） -->
    <Content Include="THIRD_PARTY_LICENSES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- OpenJTalk ランタイムファイル（setup.ps1 実行後に Data\openjtalk\ に配置）-->
    <!-- jtalk.dll は exe と同じ階層に置く必要があるため Link でフラット化 -->
    <Content Include="Data\openjtalk\jtalk.dll"
             CopyToOutputDirectory="PreserveNewest"
             Link="jtalk.dll"
             Condition="Exists('Data\openjtalk\jtalk.dll')" />
    <!-- 依存 DLL（jtalkdll ビルドで生成された追加 DLL） -->
    <Content Include="Data\openjtalk\*.dll"
             Exclude="Data\openjtalk\jtalk.dll"
             CopyToOutputDirectory="PreserveNewest"
             Link="%(Filename)%(Extension)"
             Condition="Exists('Data\openjtalk')" />
    <!-- MeCab 辞書・音声モデル（Data\openjtalk\ 以下の構造を保ったままコピー） -->
    <Content Include="Data\openjtalk\open_jtalk_dic_utf_8\**"
             CopyToOutputDirectory="PreserveNewest"
             Condition="Exists('Data\openjtalk\open_jtalk_dic_utf_8')" />
    <Content Include="Data\openjtalk\voice\**"
             CopyToOutputDirectory="PreserveNewest"
             Condition="Exists('Data\openjtalk\voice')" />
  </ItemGroup>

  <!-- OpenJTalk ランタイム欠落時のビルド警告（Release ビルド時のみ） -->
  <Target Name="WarnOpenJTalkMissing" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release'">
    <Warning Text="OpenJTalk: jtalk.dll が見つかりません。配布前に setup_openjtalk.ps1 を実行して Data\openjtalk\ を配置してください。"
             Condition="!Exists('$(MSBuildProjectDirectory)\Data\openjtalk\jtalk.dll')" />
    <Warning Text="OpenJTalk: MeCab 辞書が見つかりません。Data\openjtalk\open_jtalk_dic_utf_8\ を配置してください。"
             Condition="!Exists('$(MSBuildProjectDirectory)\Data\openjtalk\open_jtalk_dic_utf_8')" />
    <Warning Text="OpenJTalk: 音声モデルが見つかりません。Data\openjtalk\voice\ を配置してください。"
             Condition="!Exists('$(MSBuildProjectDirectory)\Data\openjtalk\voice')" />
  </Target>

</Project>
