<Window x:Class="TxtToVoice.Dialogs.TemplateManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="原稿テンプレート"
        Height="470" Width="640"
        MinHeight="300" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F0F2F5">

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ツールバー: 追加 / 編集 / 削除 + ソート切替 (#120) -->
        <DockPanel Grid.Row="0">
            <ComboBox x:Name="CmbSortOrder" DockPanel.Dock="Right"
                      Width="130" Height="26"
                      SelectionChanged="CmbSortOrder_SelectionChanged"
                      ToolTip="テンプレートの表示順序">
                <ComboBoxItem Content="最近使った順"/>
                <ComboBoxItem Content="タイトル順"/>
                <ComboBoxItem Content="使用回数順"/>
            </ComboBox>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnAddTemplate" Content="追加"
                        Width="60" Height="26" Margin="0,0,4,0"
                        Click="BtnAddTemplate_Click"
                        ToolTip="新しいテンプレートを追加"/>
                <Button x:Name="BtnEditTemplate" Content="編集"
                        Width="60" Height="26" Margin="0,0,4,0"
                        IsEnabled="False"
                        Click="BtnEditTemplate_Click"
                        ToolTip="選択したテンプレートを編集"/>
                <Button x:Name="BtnDeleteTemplate" Content="削除"
                        Width="60" Height="26"
                        IsEnabled="False"
                        Click="BtnDeleteTemplate_Click"
                        ToolTip="選択したテンプレートを削除"/>
            </StackPanel>
        </DockPanel>

        <!-- 検索フィルター (#109) -->
        <DockPanel Grid.Row="2">
            <TextBlock Text="検索：" VerticalAlignment="Center" FontSize="12"
                       Margin="0,0,6,0"/>
            <Button x:Name="BtnFilterClear" DockPanel.Dock="Right"
                    Content="×" Width="24" Height="24"
                    FontSize="11" Padding="0"
                    Click="BtnFilterClear_Click"
                    ToolTip="フィルターをクリア"/>
            <TextBox x:Name="TxtFilter"
                     FontSize="12" Padding="4,2"
                     TextChanged="TxtFilter_TextChanged"
                     ToolTip="タイトルまたは内容で絞り込み（部分一致）"/>
        </DockPanel>

        <!-- テンプレート一覧 DataGrid -->
        <DataGrid Grid.Row="4"
                  x:Name="TemplateGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  FontSize="12"
                  BorderThickness="1"
                  BorderBrush="#CCC"
                  SelectionChanged="TemplateGrid_SelectionChanged"
                  MouseDoubleClick="TemplateGrid_MouseDoubleClick">
            <!-- ピン留め行は薄い黄色背景で強調 (#131) -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                            <Setter Property="Background" Value="#FFFDE7"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <!-- ★ ピン留めトグルボタン (#131) -->
                <DataGridTemplateColumn Header="★" Width="36" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding PinIcon}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="14"
                                    Padding="2,0"
                                    Cursor="Hand"
                                    Click="BtnPinCell_Click"
                                    ToolTip="ピン留めをトグル（ピン留め項目は常に先頭に表示されます）"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="タイトル"
                                    Binding="{Binding Title}"
                                    IsReadOnly="True"
                                    Width="150"/>
                <DataGridTextColumn Header="最終使用"
                                    Binding="{Binding LastUsedDisplay}"
                                    IsReadOnly="True"
                                    Width="100"/>
                <DataGridTextColumn Header="使用回数"
                                    Binding="{Binding UsageCount}"
                                    IsReadOnly="True"
                                    Width="70"/>
                <DataGridTextColumn Header="内容プレビュー"
                                    Binding="{Binding Preview}"
                                    IsReadOnly="True"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ボタン -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnInsert" Content="挿入して閉じる"
                    Width="120" Height="28" Margin="0,0,8,0"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="BtnInsert_Click"
                    ToolTip="選択したテンプレートを原稿入力欄に挿入します"/>
            <Button x:Name="BtnClose" Content="閉じる"
                    Width="80" Height="28"
                    IsCancel="True"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
