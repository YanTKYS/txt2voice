<Window x:Class="TxtToVoice.Dialogs.TemplateEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="テンプレート編集"
        Height="320" Width="480"
        MinHeight="260" MinWidth="360"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <DockPanel Grid.Row="0">
            <TextBlock Text="タイトル：" VerticalAlignment="Center"
                       FontSize="13" MinWidth="70" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtTitle"
                     FontSize="13" Padding="4,3" Height="28"
                     MaxLength="60"
                     ToolTip="テンプレートの名前（最大60文字）"
                     TextChanged="TxtTitle_TextChanged"/>
        </DockPanel>

        <!-- 内容 ラベル -->
        <TextBlock Grid.Row="2" Text="内容：" FontSize="13"/>

        <!-- 内容 テキストボックス -->
        <TextBox Grid.Row="4" x:Name="TxtContent"
                 FontSize="13"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Padding="6,4"
                 ToolTip="テンプレートとして登録するテキスト"/>

        <!-- バリデーションエラー -->
        <TextBlock Grid.Row="6" x:Name="TxtError"
                   FontSize="11" Foreground="#CC0000"
                   Visibility="Collapsed"/>

        <!-- ボタン -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnOk" Content="OK" IsDefault="True"
                    Style="{StaticResource DialogButton}"
                    Background="#2C5F8A" Foreground="White" BorderThickness="0"
                    Click="BtnOk_Click"/>
            <Button x:Name="BtnCancel" Content="キャンセル" IsCancel="True"
                    Style="{StaticResource DialogButton}"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
