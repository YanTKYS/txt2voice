<Window x:Class="TxtToVoice.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定"
        Height="560" Width="520"
        MinHeight="460" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F0F2F5">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">

            <!-- ── 基本タブ ── -->
            <TabItem Header="基本">
                <StackPanel Margin="0,10,0,0">

                    <!-- 音声エンジン -->
                    <GroupBox Header="音声エンジン" Padding="12,8,12,10">
                        <StackPanel>
                            <RadioButton x:Name="RbSystemSpeech"
                                         Content="Windows SAPI (System.Speech) — 既定、従来の音声（Haruka 等）"
                                         FontSize="12" Margin="0,4"/>
                            <RadioButton x:Name="RbWinRt"
                                         Content="Windows WinRT (OneCore) — OneCore 系高品質音声を使用"
                                         FontSize="12" Margin="0,4"/>
                            <RadioButton x:Name="RbOpenJTalk"
                                         Content="OpenJTalk — 日本語専用 TTS（要セットアップ: setup_openjtalk.ps1）"
                                         FontSize="12" Margin="0,4"/>
                            <TextBlock FontSize="10" Foreground="#666" Margin="0,6,0,0" TextWrapping="Wrap">
                                ※ エンジン変更は再生停止中に即時反映されます。再生中の場合は次回起動時に反映されます。音声の選択はダイアログを閉じた後に再設定してください。
                                OpenJTalk を選択する場合は事前に setup_openjtalk.ps1 を実行してください（TxtToVoice.exe と同じフォルダ）。
                            </TextBlock>
                        </StackPanel>
                    </GroupBox>

                    <!-- 音声保存ファイル名 (#110) -->
                    <GroupBox Header="音声保存ファイル名" Padding="12,8,12,10" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="プレフィックス："
                                           VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" MinWidth="90"/>
                                <TextBox x:Name="TxtSaveFilePrefix"
                                         FontSize="12" Padding="4,2" MaxLength="32"
                                         TextChanged="TxtSaveFilePrefix_TextChanged"
                                         ToolTip="命名テンプレート内の {prefix} 変数の値（例: kouhou）"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="命名テンプレート："
                                           VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" MinWidth="90"/>
                                <TextBox x:Name="TxtFileNameTemplate"
                                         FontSize="12" Padding="4,2" MaxLength="80"
                                         TextChanged="TxtFileNameTemplate_TextChanged"
                                         ToolTip="変数: {prefix} {date}=yyyyMMdd {time}=HHmmss {datetime}=yyyyMMdd_HHmmss {title}=原稿先頭行"/>
                            </DockPanel>
                            <TextBlock FontSize="10" Foreground="#777" Margin="0,0,0,4"
                                       Text="変数: {prefix}  {date}  {time}  {datetime}  {title}（原稿先頭行）"/>
                            <DockPanel>
                                <TextBlock Text="プレビュー："
                                           FontSize="10" Foreground="#555" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtFileNamePreview"
                                           FontSize="10" Foreground="#2C5F8A" VerticalAlignment="Center"
                                           FontFamily="Consolas, Courier New"/>
                            </DockPanel>
                            <TextBlock FontSize="10" Foreground="#666" Margin="0,4,0,0"
                                       Text="※ 空白のみの場合はそれぞれ既定値に戻ります。"/>

                            <Separator Margin="0,8,0,6"/>

                            <!-- 一括保存形式 (#114) -->
                            <TextBlock Text="一括保存形式（複数選択可）："
                                       FontSize="12" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="ChkBatchMp3" Content="MP3"
                                          FontSize="12" Margin="0,0,12,0" VerticalContentAlignment="Center"/>
                                <CheckBox x:Name="ChkBatchWav" Content="WAV"
                                          FontSize="12" Margin="0,0,12,0" VerticalContentAlignment="Center"/>
                                <CheckBox x:Name="ChkBatchMp4" Content="MP4(AAC)"
                                          FontSize="12" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <TextBlock FontSize="10" Foreground="#666" Margin="0,4,0,0"
                                       Text="「一括保存」ボタンで選択した形式を同時出力します。"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 表示設定 (#124) -->
                    <GroupBox Header="表示設定" Padding="12,8,12,10" Margin="0,12,0,0">
                        <CheckBox x:Name="ChkShowLineNumbers"
                                  Content="入力エリアに行番号を表示する"
                                  FontSize="12" Margin="0,2"/>
                    </GroupBox>

                </StackPanel>
            </TabItem>

            <!-- ── 詳細タブ ── -->
            <TabItem Header="詳細">
                <StackPanel Margin="0,10,0,0">

                    <!-- 機微データ保存ポリシー -->
                    <GroupBox Header="機微データ保存ポリシー" Padding="12,8,12,10">
                        <StackPanel>
                            <CheckBox x:Name="ChkSaveLastInputText"
                                      Content="前回テキストをアプリ終了時に保存する（次回起動時に復元）"
                                      FontSize="12" Margin="0,4"/>
                            <CheckBox x:Name="ChkSaveRecentFiles"
                                      Content="最近使ったファイルのリストを保存する"
                                      FontSize="12" Margin="0,4"/>
                            <CheckBox x:Name="ChkClearSensitiveDataOnExit"
                                      Content="終了時に入力テキスト・ファイル履歴を消去する（監査向け）"
                                      FontSize="12" Margin="0,4"/>
                            <CheckBox x:Name="ChkDeleteLogOnExit"
                                      Content="終了時にログファイルも削除する（監査向け・強化オプション）"
                                      FontSize="12" Margin="20,2,0,4"
                                      IsEnabled="{Binding IsChecked, ElementName=ChkClearSensitiveDataOnExit}"
                                      ToolTip="「消去する」がオンのときに有効になります。INFO ログ抑制に加えて、終了時にその日のログファイルを削除します。"/>
                            <TextBlock FontSize="10" Foreground="#666" Margin="0,6,0,0"
                                       TextWrapping="Wrap">
                                ※「消去する」をオンにすると入力テキスト・ファイル履歴を保存せず、INFO ログの書き込みも抑制されます。
                                「ログも削除」をオンにするとさらに終了時にその日のログファイルを削除します（ログの場所はバージョン情報で確認できます）。
                            </TextBlock>
                        </StackPanel>
                    </GroupBox>

                    <!-- 監査ログ保持期間 -->
                    <GroupBox Header="監査ログ保持期間" Padding="12,8,12,10" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="月次ログ（audit_YYYYMM.csv）を"
                                           VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbAuditRetention" Width="150" FontSize="12">
                                    <ComboBoxItem Tag="0"  Content="無制限（自動削除なし）"/>
                                    <ComboBoxItem Tag="3"  Content="3か月"/>
                                    <ComboBoxItem Tag="6"  Content="6か月"/>
                                    <ComboBoxItem Tag="13" Content="13か月（既定）"/>
                                    <ComboBoxItem Tag="24" Content="24か月"/>
                                </ComboBox>
                                <TextBlock Text="保持する" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock FontSize="10" Foreground="#666" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="※ 起動時および設定変更時に、保持期間を超えた古い月次ファイルを自動削除します。"/>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </TabItem>

        </TabControl>

        <!-- OK / キャンセル -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnOk" Content="OK"
                    Width="80" Height="28" Margin="0,0,8,0"
                    IsDefault="True"
                    Click="BtnOk_Click"/>
            <Button x:Name="BtnCancel" Content="キャンセル"
                    Width="80" Height="28"
                    IsCancel="True"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
