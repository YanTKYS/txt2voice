<Window x:Class="TxtToVoice.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定"
        Height="230" Width="500"
        MinHeight="200" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F0F2F5">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 機微データ保存ポリシー -->
        <GroupBox Grid.Row="0" Header="機微データ保存ポリシー" Padding="12,8,12,10">
            <StackPanel>
                <CheckBox x:Name="ChkSaveLastInputText"
                          Content="前回テキストをアプリ終了時に保存する（次回起動時に復元）"
                          FontSize="12" Margin="0,4"/>
                <CheckBox x:Name="ChkSaveRecentFiles"
                          Content="最近使ったファイルのリストを保存する"
                          FontSize="12" Margin="0,4"/>
                <CheckBox x:Name="ChkClearSensitiveDataOnExit"
                          Content="終了時にテキスト・ファイル履歴を消去する（監査向け）"
                          FontSize="12" Margin="0,4"/>
                <TextBlock FontSize="10" Foreground="#666" Margin="0,6,0,0"
                           TextWrapping="Wrap">
                    ※「消去する」をオンにすると、他の設定に関わらず終了時に機微データを保存しません
                </TextBlock>
            </StackPanel>
        </GroupBox>

        <!-- OK / キャンセル -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnOk" Content="OK"
                    Width="80" Height="28" Margin="0,0,8,0"
                    IsDefault="True"
                    Click="BtnOk_Click"/>
            <Button x:Name="BtnCancel" Content="キャンセル"
                    Width="80" Height="28"
                    IsCancel="True"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
