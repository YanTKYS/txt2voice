<Window x:Class="TxtToVoice.Dialogs.TextRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="読みルール設定"
        Height="600" Width="640"
        MinHeight="460" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F0F2F5">

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ツールバー: 追加 / 編集 / 削除 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button x:Name="BtnAddRule" Content="追加"
                    Width="60" Height="26" Margin="0,0,4,0"
                    Click="BtnAddRule_Click"
                    ToolTip="新しいルールを追加"/>
            <Button x:Name="BtnEditRule" Content="編集"
                    Width="60" Height="26" Margin="0,0,4,0"
                    IsEnabled="False"
                    Click="BtnEditRule_Click"
                    ToolTip="選択したルールを編集"/>
            <Button x:Name="BtnDeleteRule" Content="削除"
                    Width="60" Height="26"
                    IsEnabled="False"
                    Click="BtnDeleteRule_Click"
                    ToolTip="選択したルールを削除"/>
        </StackPanel>

        <!-- ルール一覧 DataGrid -->
        <DataGrid Grid.Row="2"
                  x:Name="RuleGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  FontSize="12"
                  BorderThickness="1"
                  BorderBrush="#CCC"
                  SelectionChanged="RuleGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="有効"
                                        Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                        Width="48"/>
                <DataGridTextColumn Header="パターン"
                                    Binding="{Binding Pattern}"
                                    IsReadOnly="True"
                                    Width="140"/>
                <DataGridTextColumn Header="置換後"
                                    Binding="{Binding Replacement}"
                                    IsReadOnly="True"
                                    Width="150"/>
                <DataGridTextColumn Header="説明"
                                    Binding="{Binding Description}"
                                    IsReadOnly="True"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 有効ファイルパス + 注記 (#75) -->
        <StackPanel Grid.Row="3" Margin="0,3,0,0">
            <TextBlock x:Name="TxtRulesPathLabel"
                       FontSize="10" Foreground="#888"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock FontSize="10" Foreground="#666"
                       TextWrapping="Wrap"
                       Text="※ 保存後、再生停止中は即時反映。再生中の場合は次回エンジン切替またはアプリ再起動時に反映。"/>
        </StackPanel>

        <!-- テスト入力ヘッダー -->
        <TextBlock Grid.Row="5" Text="テスト入力" FontWeight="SemiBold" FontSize="12"/>

        <!-- 入力欄 -->
        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="入力:" VerticalAlignment="Center" FontSize="12"/>
            <TextBox   Grid.Column="1" x:Name="TxtTestInput" Height="26" FontSize="12"
                       TextChanged="TxtTestInput_TextChanged"/>
        </Grid>

        <!-- 変換結果 + 無効ルール診断 (#79) -->
        <StackPanel Grid.Row="9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="変換:" VerticalAlignment="Center" FontSize="12"/>
                <TextBox   Grid.Column="1" x:Name="TxtTestResult" Height="26" FontSize="12"
                           IsReadOnly="True" Background="#F8F8F8"/>
            </Grid>
            <TextBlock x:Name="TxtDiagnostic"
                       FontSize="10" Foreground="#CC4400"
                       Margin="46,2,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- ボタン -->
        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnOk" Content="保存して閉じる"
                    Width="120" Height="28" Margin="0,0,8,0"
                    IsDefault="True"
                    Click="BtnOk_Click"/>
            <Button x:Name="BtnCancel" Content="キャンセル"
                    Width="80" Height="28"
                    IsCancel="True"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
