<Window x:Class="TxtToVoice.Dialogs.TextRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="読みルール設定"
        Height="560" Width="640"
        MinHeight="420" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F0F2F5">

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ルール一覧 DataGrid -->
        <DataGrid Grid.Row="0"
                  x:Name="RuleGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  FontSize="12"
                  BorderThickness="1"
                  BorderBrush="#CCC">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="有効"
                                        Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                        Width="48"/>
                <DataGridTextColumn Header="パターン"
                                    Binding="{Binding Pattern}"
                                    IsReadOnly="True"
                                    Width="140"/>
                <DataGridTextColumn Header="置換後"
                                    Binding="{Binding Replacement}"
                                    IsReadOnly="True"
                                    Width="150"/>
                <DataGridTextColumn Header="説明"
                                    Binding="{Binding Description}"
                                    IsReadOnly="True"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 注記 -->
        <TextBlock Grid.Row="1"
                   FontSize="10" Foreground="#666"
                   TextWrapping="Wrap"
                   Text="※ 保存後、次回エンジン起動時（エンジン切替またはアプリ再起動）に読み上げへ反映されます。"/>

        <!-- テスト入力ヘッダー -->
        <TextBlock Grid.Row="3" Text="テスト入力" FontWeight="SemiBold" FontSize="12"/>

        <!-- 入力欄 -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="入力:" VerticalAlignment="Center" FontSize="12"/>
            <TextBox   Grid.Column="1" x:Name="TxtTestInput" Height="26" FontSize="12"
                       TextChanged="TxtTestInput_TextChanged"/>
        </Grid>

        <!-- 変換結果 -->
        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="変換:" VerticalAlignment="Center" FontSize="12"/>
            <TextBox   Grid.Column="1" x:Name="TxtTestResult" Height="26" FontSize="12"
                       IsReadOnly="True" Background="#F8F8F8"/>
        </Grid>

        <!-- ボタン -->
        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnOk" Content="保存して閉じる"
                    Width="120" Height="28" Margin="0,0,8,0"
                    IsDefault="True"
                    Click="BtnOk_Click"/>
            <Button x:Name="BtnCancel" Content="キャンセル"
                    Width="80" Height="28"
                    IsCancel="True"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
